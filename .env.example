# ----- AI (Cloudflare Workers AI) -----
# No API key needed — inference uses the native "AI" binding declared in wrangler.jsonc.
# Override the default model (optional). Defaults are free-plan eligible.
# CF_AI_MODEL=@cf/openai/gpt-oss-20b
# CF_AI_FALLBACK_MODEL=@cf/zai-org/glm-4.7-flash
#
# (Legacy OpenAI-compatible backend is no longer used; AI_API_KEY / AI_BASE_URL are ignored.)
